@page "/postpage"
@using HearthRemedies.Model
@using RemedyLib.Data;
@inject RemedyService Remedies;
@inject PostTransferService PostTransfer
@inject NavigationManager Nav

<button class="btn btn-secondary" @onclick="GoBack">
    ← Back
</button>
<div class="post-page">
    <button class="back-btn" @onclick="GoBack">
        ← Back
    </button>

    @if (post == null)
    {
        <div class="empty-state">
            No post was provided.
        </div>
    }
    else
    {
        <!-- Header: tags, title, date, description, votes -->
        <section class="post-header">
            <div class="tags">
                <span class="tag">@post.Category.GetDisplayName()</span>
                <span class="tag tag-method">@post.UsageMethod.GetDisplayName()</span>
                @if (post.IsHidden)
                {
                    <span class="tag tag-hidden">Hidden</span>
                }
                @if (post.Reports.Count > 0)
                {
                    <span class="tag tag-reported">Reports: @post.Reports.Count</span>
                }
            </div>

            <h1 class="post-title">@post.Title</h1>
            <time class="post-date">Posted @post.CreatedUtc.ToLocalTime().ToString("MMMM d, yyyy")</time>

            @* @if (!string.IsNullOrWhiteSpace(post.ImgUrl))
            {
                <img src="@post.ImgUrl" class="post-image" alt="@post.Title" />
            } *@

            @if (!string.IsNullOrWhiteSpace(post.Description))
            {
                <p class="post-description">@post.Description</p>
            }

            <!-- Voting -->
            <div class="vote-bar">
                <button class="vote up @(post.MyVote == 1 ? "active" : "")" @onclick="() => Vote(1)" aria-label="Upvote">
                    ▲ @FormatCount(GetVotes())
                </button>
                <button class="vote down @(post.MyVote == -1 ? "active" : "")" @onclick="() => Vote(-1)" aria-label="Downvote">
                    ▼ @FormatCount(GetVotes(false))
                </button>

                <!-- <button class="btn btn-warning" @onclick="Report">
                    ⚠️ Report
                </button> -->
            </div>
        </section>

        <!-- Ingredients -->
        <details class="section" open>
            <summary class="section-title">
                Ingredients
                <span class="count">@ingredients.Length</span>
            </summary>
            <ul class="ingredient-list">
                @foreach (var ingredient in ingredients)
                {
                    <li>@ingredient</li>
                }
            </ul>
        </details>

        <!-- Steps -->
        <details class="section" open>
            <summary class="section-title">
                Steps
                <span class="count">@steps.Length</span>
            </summary>
            <ol class="step-list">
                @foreach (var step in steps)
                {
                    <li>@step</li>
                }
            </ol>
        </details>
    }
</div>

@code {
    private Post? post;

    // This device's vote when the page opened. post.Votes already includes it,
    // so it's swapped out for the current post.MyVote when counting.
    private int startingVote;
    public string[] ingredients = Array.Empty<string>();
    public string[] steps = Array.Empty<string>();
    [Parameter] public EventCallback<Post> OnVoted { get; set; }

    protected override void OnInitialized()
    {
        post = PostTransfer.CurrentPost;
        if (post != null)
        {
            startingVote = post.MyVote;
            ingredients = SplitIngredients(post.Ingredients);
            steps = SplitLines(post.Steps);
        }
    }

    // One item per line, ignoring blank lines and stray "\r" from Windows line endings
    private static string[] SplitLines(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // Ingredients typed on one line ("Egg, Cheese") are split on commas.
    // Ones typed one per line keep their commas ("1 cup oats, ground fine").
    private static string[] SplitIngredients(string text) =>
        text.Contains('\n')
            ? SplitLines(text)
            : text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private int GetVotes(bool postive = true)
    {
        if (post == null) return 0;

        int value = postive ? 1 : -1;
        int count = post.Votes.Count(v => v.Value == value);

        if (startingVote == value) count--;
        if (post.MyVote == value) count++;

        return count;
    }

    async Task VoteData(int dir)
    {
        var updated = await Remedies.VoteAsync(post!.Id, dir);
        if (updated is not null) { post.Score = updated.Score; post.MyVote = updated.MyVote; }
    }

    private async Task Vote(int direction)
    {
        await VoteData(direction);

        await OnVoted.InvokeAsync(post);
    }

    private static string FormatCount(int n) => n switch
    {
        >= 1_000_000 => $"{n / 1_000_000d:0.#}m",
        >= 1_000 => $"{n / 1_000d:0.#}k",
        _ => n.ToString()
    };

    //void Report()
    //{
    //    post?.changeReport(1);
    //}
    private void GoBack()
    {
        Nav.NavigateTo("/");
    }
}
