@page "/postpage"
@using HearthRemedies.Model
@using RemedyLib.Data;
@inject RemedyService Remedies;
@inject PostTransferService PostTransfer
@inject NavigationManager Nav

<button class="back-btn" @onclick="GoBack">
    ← Back
</button>

@if (post == null)
{
    <div class="alert alert-warning mt-4">
        No post was provided.
    </div>
}
else
{
    <div class="container mt-4">

        <!-- Title + Category -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>@post.Title</h2>
            <span class="badge bg-primary fs-6">@post.Category</span>
            <span class="badge bg-primary fs-6">@post.UsageMethod</span>
        </div>

        <!-- Image -->
        @* @if (!string.IsNullOrWhiteSpace(post.ImgUrl))
        {
            <img src="@post.ImgUrl" class="img-fluid rounded mb-3 shadow-sm" alt="@post.Name" />
        } *@

        <!-- Description -->
        <details class="dropdown-section">
            <summary class="dropdown-title">Description</summary>
            <p>@post.Description</p>
        </details>


        <!-- Ingredients -->
        <details class="dropdown-section">
            
            <summary class="dropdown-title">Ingredients (ingredients.Length)</summary>
            <ul>
                @foreach (var ingredient in ingredients)
                {
                    <li>@ingredient</li>
                }
            </ul>
        </details>


        <!-- Steps -->
        <details class="dropdown-section">
            <summary class="dropdown-title">Steps (steps.Length)</summary>
            <ol>
                @foreach (var step in steps)
                {
                    <li>@step</li>
                }
            </ol>
        </details>


        

        <!-- Metadata -->
        <div class="text-muted mb-3">
            <small>Created: @post.CreatedUtc.ToString("MMMM dd, yyyy")</small><br />
            @if (post.IsHidden)
            {
                <span class="badge bg-secondary">Hidden</span>
            }
            @if (post.Reports.Count > 0)
            {
                <span class="badge bg-danger">Reports: @post.Reports.Count</span>
            }
        </div>

        <!-- Voting -->
        <div class="d-flex gap-3 mb-4">
            <button class="vote up @(myVote == 1 ? "active" : "")" @onclick="() => Vote(1)" aria-label="Upvote">
            ▲  @FormatCount(GetVotes())
        </button>
        <button class="vote down @(myVote == -1 ? "active" : "")" @onclick="() => Vote(-1)" aria-label="Downvote">
            ▼ @FormatCount(GetVotes(false))
        </button>

            <!-- <button class="btn btn-warning" @onclick="Report">
                ⚠️ Report
            </button> -->
        </div>

    </div>
}

@code {
    private Post? post;

    private int myVote;
    public string[] ingredients;
    public string[] steps;
    [Parameter] public EventCallback<Post> OnVoted { get; set; }

    protected override void OnInitialized()
    {
        post = PostTransfer.CurrentPost;
        myVote = 0;
        if (post != null)
        {
            ingredients = post.Ingredients.Split("\n");
            steps = post.Steps.Split("\n");
        }
    }
    private int GetVotes(bool postive = true)
    {
        int count = 0;
        foreach (Vote vote in post.Votes)
        {
            if (postive)
            {
                if (vote.Value == 1)
                    count++;


            }
            else
            {
                if (vote.Value == -1)
                    count--;

            }

        }
        /*
        if (postive)
        {
            // if (myVote == 1)
            count += postUp;
            }
        else
        {
            // if (myVote == -1)
            count+=postDown;
            }*/
        
        if (postive)
        {
            if (post.MyVote == 1)
                count += post.MyVote;
            }
        else
        {
            if (post.MyVote == -1)
                count += post.MyVote;
            }

    return count;
    }

    async Task VoteData(int dir)
    {

        var updated = await Remedies.VoteAsync(post.Id, dir);
        if (updated is not null) { post.Score = updated.Score; post.MyVote = updated.MyVote; }
    }
    private async Task Vote(int direction)
    {
        // Undo the current vote first
        // if (myVote == 1) post.UpVoteNum--;
        // else if (myVote == -1) post.DownVoteNum--;

        // Clicking the same arrow again removes the vote
        // myVote = myVote == direction ? 0 : direction;

        // if (myVote == 1) post.UpVoteNum++;
        // else if (myVote == -1) post.DownVoteNum++;
        await VoteData(direction);

        await OnVoted.InvokeAsync(post);
    }

    private static string FormatCount(int n) => n switch
    {
        >= 1_000_000 => $"{n / 1_000_000d:0.#}m",
        >= 1_000 => $"{n / 1_000d:0.#}k",
        _ => n.ToString()
    };

    //void Report()
    //{
    //    post?.changeReport(1);
    //}
    private void GoBack()
    {
        Nav.NavigateTo("/");
    }
}
