@page "/newpost"
@using RemedyLib.Data
@inject RemedyService Remedies
@inject NavigationManager Nav

<button class="btn btn-secondary" @onclick="GoBack">
    ← Back
</button>
<h3>Create your new post</h3>
@if (errorMessage != null)
{
    if (errorMessage == "good")
    {
        <p class="text-success">Post created successfully!</p>
    }
    else
    {
        <p class="text-danger">@errorMessage</p>
    }

}



<EditForm Model="newPost" FormName="AddPostForm" OnValidSubmit="AddPost">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText @bind-Value="newPost.Title" placeholder="Title"></InputText>
    <br />
    <InputText @bind-Value="newPost.Description" placeholder="Description"></InputText>
    <br />
    <InputTextArea @bind-Value="newPost.Ingredients" rows="4" placeholder="Ingredients (one per line)"></InputTextArea>
    <br />
    <InputTextArea @bind-Value="newPost.Steps" rows="5" placeholder="Steps (one per line)"></InputTextArea>
    <br />
    <InputSelect TValue="Category" placeholder="Remedy type" @bind-Value="newPost.Category">
        <option value=null>Select a remedy type</option>
        @foreach (Category remedy in Enum.GetValues<Category>())
        {
            <option value="@remedy">@remedy</option>
        }
    </InputSelect>
    <InputSelect TValue="UsageMethod" placeholder="Usage Method" @bind-Value="newPost.UsageMethod">
        <option value=null>Select a usage method</option>
        @foreach (UsageMethod usage in Enum.GetValues<UsageMethod>())
        {
            <option value="@usage">@usage</option>
        }
    </InputSelect>
    <br />
    <label for="Hidden">Hide post</label>
    <InputCheckbox id="Hidden" @bind-Value="newPost.IsHidden">
        <input type="checkbox" />
    </InputCheckbox>
    <input class="btn btn-primary btn-block" type="submit" value="Create post" />
</EditForm>

@code {
    private Post newPost { get; set; } = new Post();
    string? errorMessage;
    private async Task AddPost()
    {
        //errorMessage = Remedies.CreatePostAsync(newPost).Result;
        var result = await Remedies.CreatePostAsync(newPost);
        errorMessage = (result == null) ? "good" : result;
        newPost = new Post();

    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }
}
