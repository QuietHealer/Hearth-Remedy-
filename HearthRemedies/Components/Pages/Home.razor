@page "/"
@using HearthRemedies.Model
@inject PostFilterState Filters
@using RemedyLib.Data
@inject RemedyService Remedies
@implements IDisposable

<h1>Results</h1>

@foreach (var result in FilteredResults)
{
    <Post_MiniView @key="result" Post="result" />
}

@if (!FilteredResults.Any())
{
    <p>No remedies in this category yet.</p>
}

@code
{
    public static List<Post> posts = new();

    private static List<string> ingredients = new() { "Honey", "Water" };
    private static List<string> steps = new() { "Mix honey and water together.", "Stir until well combined.", "Serve chilled or over ice." };

    protected override async Task OnInitializedAsync()
    {
        posts = await Remedies.GetFeedAsync(FeedSort.Top, DateRange.AllTime);
    }

    protected override void OnInitialized()
    {
        // Redraw this page whenever a filter in the top bar changes
        Filters.OnChange += HandleFilterChanged;
        /*
        results.Add(new Posts
        {
            Name = "Honey Water",
            Description = "A refreshing drink made with honey and water.",
            Ingredients = ingredients,
            Steps = steps,
            Category = RemedyType.Throat,
            UsageMethod = RemedyMethod.Drink
        });
        results.Add(new Posts
        {
            Name = "Honey Lemon",
            Description = "A refreshing drink made with honey and lemon.",
            Ingredients = ingredients,
            Steps = steps,
            Category = RemedyType.Skin,
            UsageMethod = RemedyMethod.Skin
        });*/
    }

    private IEnumerable<Post> FilteredResults
    {
        get
        {
            var query = posts.Where(p => !p.IsHidden);

            if (Filters.Type is not null)
                query = query.Where(p => p.Category == Filters.Type);

            if (Filters.Method is not null)
                query = query.Where(p => p.UsageMethod == Filters.Method);

            return Filters.Sort switch
            {
                PostSort.Top => query.OrderByDescending(p => p.Score),// .UpVoteNum - p.DownVoteNum),
                _ => query.OrderByDescending(p => p.CreatedUtc)//.CreatedAt)
            };
        }
    }

    private void HandleFilterChanged() => InvokeAsync(StateHasChanged);

    // Unsubscribe when leaving the page, or the service keeps calling a page that's gone
    public void Dispose() => Filters.OnChange -= HandleFilterChanged;
}