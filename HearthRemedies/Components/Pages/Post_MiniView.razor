@using HearthRemedies.Model
@using RemedyLib.Data
@inject RemedyService Remedies

<article class="post-card">
    <div class="post-body">
        <section class="post-main">
            @* @if (!string.IsNullOrWhiteSpace(Post.ImgUrl))
            {
                <img class="post-image" src="@Post.ImgUrl" alt="@Post.Name" />
            } *@
            <h3 class="post-title">@Post.Title</h3>
            <span class="post-category">@Post.Category.GetDisplayName()</span>
            <span class="post-category">@Post.UsageMethod.GetDisplayName()</span>
            @if (!string.IsNullOrWhiteSpace(Post.Description))
            {
                <p class="post-description">@Post.Description</p>
            }
        </section>

        <aside class="post-ingredients">
            <h4>Ingredients</h4>
            <ul>
                @if (unformatedIngredients)
                {
                    unformatedIngredients = false;
                    ingredients = Post.Ingredients.Split("\n", 4);
                    foreach (string ing in ingredients)
                    {
                        ing.Replace(",", "");

                    }
                }
                @foreach (var ingredient in ingredients)
                {
                    <li>@ingredient</li>
                }
            </ul>
            @* @if (Post.Ingredients.Count > MaxIngredients)
            {
                <span class="more">+@(Post.Ingredients.Count - MaxIngredients) more</span>
            } *@
        </aside>
    </div>

    <footer class="post-footer">
        <button class="vote up @(myVote == 1 ? "active" : "")" @onclick="() => Vote(1)" aria-label="Upvote">
            ▲ @FormatCount(GetVotes())
        </button>
        <button class="vote down @(myVote == -1 ? "active" : "")" @onclick="() => Vote(-1)" aria-label="Downvote">
            ▼ @FormatCount(GetVotes(false))
        </button>
        <time class="post-date">@Post.CreatedUtc.ToString("MMM d")</time>
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public Post Post { get; set; } = default!;

    // Raised after a vote changes so the parent can save it / re-sort.
    [Parameter] public EventCallback<Post> OnVoted { get; set; }
    bool unformatedIngredients = true;
    private const int MaxIngredients = 4;
    private string[] ingredients = new string[MaxIngredients];

    async Task VoteData(int dir)
    {

        var updated = await Remedies.VoteAsync(Post.Id, dir);
        if (updated is not null) { Post.Score = updated.Score; Post.MyVote = updated.MyVote; }
    }


    // 1 = upvoted, -1 = downvoted, 0 = no vote
    private int myVote;
    private int GetVotes(bool postive = true)
    {
        int count = 0;
        foreach (Vote vote in Post.Votes)
        {
            if (postive)
            {
                if (vote.Value == 1)
                    count++;


            }
            else
            {
                if (vote.Value == -1)
                    count--;
                
            }

        }
/*
        if (postive)
        {
            if (myVote == 1)
                count++;
            if (myVote == -1)
                count--;
        }*/
        return count;
    }
    private async Task Vote(int direction)
    {
        // Undo the current vote first
        /*
        if (myVote == 1) Post.Score--;
        else if (myVote == -1) Post.Score--;

        // Clicking the same arrow again removes the vote

        if (myVote == 1) Post.Score++;
        else if (myVote == -1) Post.Score++;
        */
        myVote = myVote == direction ? 0 : direction;
        await VoteData(direction);

        await OnVoted.InvokeAsync(Post);
    }

    // 1300 -> "1.3k", 2500000 -> "2.5m"
    private static string FormatCount(int n) => n switch
    {
        >= 1_000_000 => $"{n / 1_000_000d:0.#}m",
        >= 1_000 => $"{n / 1_000d:0.#}k",
        _ => n.ToString()
    };
}
