@page "/posts"
@using RemedyLib.Data
@inject RemedyService Remedies

@if (error is not null)
{
    <p role="alert">@error</p>
}
@foreach (var p in posts)
{
    <div>
        <h3>@p.Title</h3>
        <p>@p.Description</p>
        <button aria-label="Upvote" @onclick="() => Vote(p, 1)">▲</button>
        <span>@p.Score</span>
        <button aria-label="Downvote" @onclick="() => Vote(p, -1)">▼</button>

    </div>
}

@code {
    List<PostSummary> posts = new();
    string? error;

    protected override async Task OnInitializedAsync()
    {
        try { posts = await Remedies.GetFeedAsync(new FeedQuery()); }
        catch { error = "Couldn't load remedies. Check your connection."; }
    }

    async Task Vote(PostSummary p, int dir)
    {
        var result = await Remedies.VoteAsync(p.Id, dir);
        if (result.Ok) { p.Score = result.Value!.Score; p.MyVote = result.Value.MyVote; }
        else error = result.Error;
    }
}

@*
@using HearthRemedies.Data
@inject IDbContextFactory<AppDbContext> DbFactory


<h3>PostViewer</h3>

@foreach (var post in posts)
{
    <p>@post.Title (@post.Score)</p>
}

@code {
    private List<Post> posts = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        posts = await db.Posts
            .Where(p => !p.IsHidden)
            .OrderByDescending(p => p.Score)
            .ToListAsync();
    }

    private async Task Upvote(Post post)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var dbPost = await db.Posts.FindAsync(post.Id);
        if (dbPost is null) return;
        dbPost.Score++;
        await db.SaveChangesAsync();
        post.Score = dbPost.Score;
    }
}
*@